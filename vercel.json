{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "font/**/*.woff2",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/font/(.*)",
      "dest": "/font/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
